# PostgreSQL (используется контейнером postgres и backend)
POSTGRES_DB=medical_products
POSTGRES_USER=medical
POSTGRES_PASSWORD=medical

# Строка подключения для backend (внутри docker-сети хост = postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medical_products
SPRING_DATASOURCE_USERNAME=medical
SPRING_DATASOURCE_PASSWORD=medical

# CORS: список origins через запятую, * — разрешить все (только для разработки!)
CORS_ALLOWED_ORIGINS=*
