# ────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните реальными значениями перед деплоем:
#   cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).
# ────────────────────────────────────────────────────────────────

# PostgreSQL (используется контейнером postgres и backend)
POSTGRES_DB=medical_products
POSTGRES_USER=medical
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Строка подключения для backend (внутри docker-сети хост = postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medical_products
SPRING_DATASOURCE_USERNAME=medical
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_db_password

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО смените, минимум 64 символа.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_64_random_characters_long_secret_key_value_here

# Учётная запись администратора (создаётся при первом запуске с пустой БД)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# CORS: список origins через запятую. В production фронт и API на одном
# origin (nginx проксирует /api и /uploads), поэтому CORS не задействован —
# можно оставить адрес домена или пустым. * — только для разработки!
CORS_ALLOWED_ORIGINS=https://your-domain.example
